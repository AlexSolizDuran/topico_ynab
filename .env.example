# Conexion con Neon. Pooled para el runtime de la app.
# sslmode=verify-full verifica ademas el certificado del servidor. `require`
# avisa con un warning de deprecacion: en pg v9 pasa a ser mas laxo.
DATABASE_URL=

# Conexion directa a Neon, sin pooler. Solo para migraciones.
DATABASE_URL_UNPOOLED=
