@startuml
title Modelo de datos — finanzas personales (sobres estilo YNAB)

hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam nodesep 60

entity "usuarios" as usuarios {
  id : bigint <<PK>>
  --
  nombre          : varchar(80)
  apellido        : varchar(80)
  nombre_usuario  : varchar(50) <<UNIQUE>>
  correo          : varchar(120) <<UNIQUE>>
  hash_contrasena : varchar(255)
  activo          : boolean
  zona_horaria    : varchar(40)
  --
  intentos_fallidos : integer
  bloqueado_hasta   : timestamp, nullable
  --
  creado_en       : timestamp
}

' Argon2id. La contrasena minima es de 6 caracteres (regla de validacion,
' no de esquema). Solo se guarda el hash, nunca la contrasena en claro.
note right of usuarios
  Argon2id via @node-rs/argon2.
  Contrasena minima: 6 caracteres.
  intentos_fallidos se reinicia a 0 tras un inicio de sesion exitoso.
  bloqueado_hasta se fija a created + 60s al llegar a 5 intentos fallidos.
  --
  OJO: el UNIQUE de nombre_usuario NO basta. El spec exige insensibilidad a
  mayusculas, y un UNIQUE normal de Postgres es sensible: permitiria "Alex" y
  "alex" a la vez. Hace falta un indice unico funcional sobre
  lower(nombre_usuario). Mismo tratamiento al buscar en el inicio de sesion.
end note

entity "sesiones" as sesiones {
  id : bigint <<PK>>
  --
  usuario_id : bigint <<FK>>
  token_hash : varchar(255) <<UNIQUE>>
  token_proteccion : varchar(255) <<UNIQUE>>
  --
  expira_en  : timestamp
  creada_en  : timestamp
}

' Sin columna de revocacion: el cierre de sesion elimina la fila.
' Al ser serverless, el estado de sesion NO puede vivir en memoria;
' por eso se persiste en Postgres.
note right of sesiones
  El identificador se almacena hasheado, no en claro.
  Viaja en cookie httpOnly + SameSite, por eso los scripts
  de la pagina no lo leen.
  El identificador es NUEVO en cada inicio de sesion.
  token_proteccion caduca con la sesion: no se reutiliza
  entre sesiones distintas.
  El cierre de sesion elimina la fila (no la marca).
end note

entity "carteras" as carteras {
  id : bigint <<PK>>
  --
  usuario_id   : bigint <<FK>>
  nombre       : varchar(60)
  moneda       : char(3)   "ISO 4217"
  archivada    : boolean
  orden        : int
  creado_en    : timestamp
  eliminado_en : timestamp, nullable
}

entity "grupos" as grupos {
  id : bigint <<PK>>
  --
  cartera_id   : bigint <<FK>>
  nombre       : varchar(60)
  archivado    : boolean
  orden        : int
  creado_en    : timestamp
}

entity "cuentas" as cuentas {
  id : bigint <<PK>>
  --
  cartera_id    : bigint <<FK>>
  nombre        : varchar(60)
  tipo          : enum(corriente, ahorro, efectivo, credito)
  saldo_inicial : numeric(16,2)
  archivada     : boolean
  orden         : int
  creado_en     : timestamp
  eliminado_en  : timestamp, nullable
}

entity "sobres" as sobres {
  id : bigint <<PK>>
  --
  cartera_id   : bigint <<FK>>
  grupo_id     : bigint <<FK>>
  nombre       : varchar(60)
  archivado    : boolean
  orden        : int
  creado_en    : timestamp
  eliminado_en : timestamp, nullable
}

entity "asignaciones" as asignaciones {
  id : bigint <<PK>>
  --
  sobre_id  : bigint <<FK>>
  periodo   : char(7)   "YYYY-MM"
  monto     : numeric(16,2)   "siempre positivo"
  creado_en : timestamp
}

entity "grupos_transferencia" as gtransf {
  id : bigint <<PK>>
  --
  descripcion : varchar(255)
  fecha       : date
  creado_en   : timestamp
}

entity "movimientos" as movimientos {
  id : bigint <<PK>>
  --
  cuenta_id       : bigint <<FK>>
  sobre_id        : bigint <<FK, nullable>>
  transferencia_id : bigint <<FK, nullable>>
  tipo            : enum(gasto, ingreso, traspaso)
  monto           : numeric(16,2)   "con signo: - gasto, + ingreso"
  fecha           : date
  descripcion     : varchar(255)
  comercio        : varchar(120), nullable
  origen          : enum(manual, recurrente)
  regla_id        : bigint <<FK, nullable>>
  eliminado_en    : timestamp, nullable
  creado_en       : timestamp
  actualizado_en  : timestamp
}

entity "metas" as metas {
  id : bigint <<PK>>
  --
  sobre_id    : bigint <<FK>>
  monto_objetivo : numeric(16,2)
  fecha_limite   : date, nullable
  estado      : enum(activa, completada, abandonada)
  completada_en : timestamp, nullable
  abandonada_en : timestamp, nullable
  creado_en   : timestamp
}

entity "reglas_recurrentes" as reglas {
  id : bigint <<PK>>
  --
  cartera_id : bigint <<FK>>
  cuenta_id  : bigint <<FK>>
  sobre_id   : bigint <<FK, nullable>>
  descripcion : varchar(255)
  monto      : numeric(16,2)   "siempre positivo"
  frecuencia : enum(diaria, semanal, mensual, anual)
  dia        : int
  mes        : int, nullable
  fecha_inicio : date
  activa     : boolean
  creado_en  : timestamp
  eliminado_en : timestamp, nullable
}

usuarios ||--o{ carteras  : posee
usuarios ||--o{ sesiones  : mantiene
carteras ||--o{ grupos   : agrupa
carteras ||--o{ cuentas  : contiene
carteras ||--o{ sobres   : contiene
carteras ||--o{ reglas   : define

grupos   ||--o{ sobres   : contiene
sobres   ||--o{ asignaciones : recibe
sobres   |o--o{ movimientos  : recibe
sobres   ||--o{ metas    : persigue

cuentas  ||--o{ movimientos  : opera
cuentas  ||--o{ reglas   : alimenta

reglas   ||--o{ movimientos : genera

gtransf  |o--o{ movimientos : empareja

note bottom of usuarios
  Un usuario puede tener varias carteras.
  El panel muestra una a la vez.
  No se suman carteras de distinta moneda.
end note

note right of carteras
  **Cada cartera tiene UNA moneda.**
  No hay tipo de cambio: los importes
  no se convierten entre carteras.
  La moneda se define al crear la cartera
  y no se cambia.
end note

note right of cuentas
  **No tiene columna de saldo.**
  El saldo SIEMPRE se calcula.

  tipo = credito => saldo NEGATIVO
  (deuda). Al restar del dinero
  suelto, la deuda lo descuenta.
end note

note right of sobres
  **No tiene columna de disponible.**
  El disponible SIEMPRE se calcula
  a partir de asignaciones + movimientos.

  Todo sobre pertenece a exactamente
  un grupo de su cartera.
  Los grupos NO se anidan.
end note

note bottom of asignaciones
  Varias asignaciones al mismo sobre
  y periodo: NO hay UNIQUE
  (sobre_id, periodo). Se suman.

  Solo positivos: aqui no hay
  sobregiros ni negativos.
  El sobregiro vive en movimientos.
end note

note right of movimientos
  **sobre_id nullable** = movimiento
  sin asignar (dinero suelto).

  tipo = traspaso NO toca sobres.
  Solo mueve saldos de cuenta.

  monto con signo:
    negativo = gasto
    positivo = ingreso o devolucion

  No lleva usuario_id ni cartera_id:
  la pertenencia se deduce por
    movimientos -> cuenta_id -> cuentas
      -> carteras -> usuarios

  tipo = traspaso con sobre_id
  NOT NULL es invalido.
end note

note right of gtransf
  Empareja las dos patas del traspaso.

  Una pata sola se permite, con aviso
  al usuario. Por eso la relacion con
  movimientos es 0..*.

  Al borrar cualquier pata, se borran
  todas las del grupo.
end note

note bottom of metas
  Varias metas por sobre a lo largo
  del tiempo, una sola activa.

  UNIQUE (sobre_id) WHERE estado = activa

  El avance SIEMPRE se calcula a partir
  del disponible del sobre.

  Al archivar un sobre, su meta activa
  pasa a abandonada.
end note

note bottom of reglas
  Genera movimientos indistinguibles
  de los manuales. Editar la regla NO
  modifica lo ya generado.

  No se duplica: si ya existe un
  movimiento equivalente en esa fecha,
  se omite la generacion.
end note

@enduml

@startuml
title Derivados — se calculan, nunca se guardan

hide circle
skinparam shadowing false
skinparam nodesep 50

rectangle "cuentas" as c
rectangle "sobres + asignaciones" as s
rectangle "movimientos" as m

rectangle "saldo de cuenta" as r1
rectangle "disponible de sobre" as r2
rectangle "dinero suelto de cartera" as r3
rectangle "patrimonio de cartera" as r4
rectangle "avance de meta" as r5

c --> r1 : saldo_inicial + SUM(monto)
m --> r1 : incluye tipo = traspaso
s --> r2 : SUM(asignaciones <= M)
m --> r2 : excluye tipo = traspaso
r1 --> r3 : SUM(saldos)
r2 --> r3 : se resta
r3 --> r4
r2 --> r4
r2 --> r5 : disponible / objetivo
r5 --> r5 : ritmo por periodo restante

note bottom of r3
  dinero_suelto( cartera ) =
    SUM(saldos) - SUM(disponibles)

  Las tarjetas entran con saldo
  negativo, por lo que restan.
  Puede quedar NEGATIVO:
  significa que repartiste de mas.
end note

note bottom of r4
  **INVARIANTE** (por cartera)

  patrimonio( cartera ) =
    SUM(disponibles) + dinero_suelto

  Si esto no cuadra, hay un bug.
  Debe cumplirse en CUALQUIER momento,
  con CUALQUIER combinacion de datos.

  Los traspasos la dejan invariante:
  mueven saldos, no disponibles.
end note

note bottom of r2
  disponible( sobre, periodo M ) =
    SUM(asignaciones donde periodo <= M)
    + SUM(monto de movimientos
          no eliminados, tipo != traspaso,
          con fecha <= fin de M)

  Los meses NO se reinician:
  el disponible de un sobre acumula.
end note

@enduml
